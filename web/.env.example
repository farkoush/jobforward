# JobForward web — gateway configuration (004-llm-gateway)
# Copy to .env.local and fill in real values. NOTHING here is a real secret.
# Every value is read exclusively from the environment at runtime (P13) —
# never hardcode model names, keys, or secrets in code.

# --- Free path provider (NVIDIA, OpenAI-compatible) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Model chains (comma-separated fallbacks; order = fallback order) ---
# Intended GEN primary value (configuration data, not code): moonshotai/kimi-k3
GEN_MODEL=
GEN_FALLBACKS=
FAST_MODEL=
FAST_FALLBACKS=

# --- Entry gate (shared password + cookie signing, FR-36) ---
GATE_PASSWORD=
GATE_COOKIE_SECRET=
GATE_COOKIE_TTL_DAYS=30

# --- Usage limits (all env-overridable; defaults match spec 004) ---
DAILY_GEN_PER_USER=15
DAILY_FAST_PER_USER=50
DAILY_GEN_GLOBAL=250
DAILY_FAST_GLOBAL=600
USER_PER_MINUTE=3
BYOK_PER_MINUTE=10
PROVIDER_RPM_LIMIT=30
BUSY_QUEUE_MS=5000
MAX_INPUT_CHARS=8000
MAX_OUTPUT_TOKENS_GEN=2000
MAX_OUTPUT_TOKENS_FAST=500

# --- Time budgets (ms) ---
ATTEMPT_TIMEOUT_MS_GEN=30000
DEADLINE_MS_GEN=60000
ATTEMPT_TIMEOUT_MS_FAST=10000
DEADLINE_MS_FAST=20000
FIRST_TOKEN_TIMEOUT_MS=20000
CHUNK_SILENCE_TIMEOUT_MS=15000

# --- Counter store (production: Vercel KV / Upstash REST) ---
# Omit both in local dev to use the built-in in-memory adapter.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Mock mode (FR-38, dev-only) ---
# "true" routes gateway attempts through the mock transport (fixed responses;
# the dev-only x-mock-error request header simulates 429/5xx/timeout/403-HTML/
# empty). IGNORED in production.
LLM_MOCK=false
